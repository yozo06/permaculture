{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://permaculture.game/schema/pack-v0.json",
  "title": "Permaculture pack (format v0)",
  "type": "object",
  "required": ["pack", "version", "title", "branches", "seeds"],
  "additionalProperties": false,
  "properties": {
    "pack": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$", "description": "Slug. Also the file name: packs/<pack>.yaml" },
    "version": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "description": { "type": "string", "maxLength": 400 },
    "readiness_bar": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Default readiness target for this field (player can change it)." },
    "perennial": { "type": "boolean", "description": "true for goals with no end (a language, a habit). Readiness is not shown." },
    "branches": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": { "type": "object", "required": ["id", "title"], "additionalProperties": false,
        "properties": { "id": { "$ref": "#/$defs/slug" }, "title": { "type": "string" }, "description": { "type": "string" } } }
    },
    "sources": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "title"], "additionalProperties": false,
        "properties": { "id": { "$ref": "#/$defs/slug" }, "title": { "type": "string" }, "url": { "type": "string" }, "note": { "type": "string" } } }
    },
    "guilds": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "title", "seeds"], "additionalProperties": false,
        "properties": { "id": { "$ref": "#/$defs/slug" }, "title": { "type": "string" }, "seeds": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/slug" } } } }
    },
    "seeds": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "layer", "branch", "tier", "harvest"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "name": { "type": "string", "minLength": 1, "maxLength": 48 },
          "layer": { "enum": ["canopy", "understory", "shrub", "herb", "ground-cover", "root", "vine"] },
          "branch": { "$ref": "#/$defs/slug", "description": "Must match a branch id in this pack." },
          "tier": { "type": "integer", "minimum": 0, "maximum": 8, "description": "Depth in the learning tree. 0 = plantable from the start." },
          "needs": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "description": "Seed ids that must be rooted first. Same pack only, for now." },
          "wild": { "type": "boolean", "description": "Hidden until foraged and domesticated." },
          "harvest": { "enum": ["recall", "solve", "judged", "artifact"] },
          "minutes": { "type": "integer", "minimum": 5, "maximum": 180, "description": "Energy cost to plant (read the source, write notes)." },
          "sources": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
          "summary": { "type": "string", "maxLength": 600, "description": "What to read and what the yield of planting is." },
          "rubric": { "type": "array", "items": { "type": "string" }, "description": "For judged harvests: what the grader scores." },
          "questions": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "water": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mcq" } },
              "harvest": { "type": "array", "items": { "$ref": "#/$defs/mcq" } }
            }
          },
          "prompts": {
            "type": "array", "items": { "type": "string" },
            "description": "For judged/artifact harvests: open prompts, one is picked at harvest time."
          }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,40}$" },
    "mcq": {
      "type": "object", "required": ["q", "answer", "distractors", "why"], "additionalProperties": false,
      "properties": {
        "q": { "type": "string", "minLength": 8 },
        "answer": { "type": "string", "minLength": 1 },
        "distractors": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string", "minLength": 1 } },
        "why": { "type": "string", "minLength": 8, "description": "Shown after answering. Teach, do not just confirm." },
        "source": { "type": "string", "description": "Source id or a short citation." }
      }
    }
  }
}
