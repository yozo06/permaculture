    "validate": "node scripts/validate-packs.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "js-yaml": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
