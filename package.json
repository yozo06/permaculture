{
  "name": "permaculture",
  "version": "0.0.1",
  "description": "A farm game where the crops are the things you are learning.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
